# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit real keys.
#
# FASTEST WAY TO GET THESE:
#   Supabase dashboard -> your project -> the "Connect" button at the top
#   -> App Frameworks -> Next.js. It shows the URL and key ready to copy.
#
# OR BY HAND:
#   URL  -> Settings -> Data API  (or read it off your browser's address bar,
#           see the note at the bottom of this file)
#   Keys -> Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co


# ---------------------------------------------------------------------
# PUBLIC KEY — safe to expose. Row-level security applies to everything
# it can reach. This is what the browser uses.
#
# Supabase is replacing the old "anon" key with a "publishable" key
# (starts with sb_publishable_). The anon key is deprecated at the end
# of 2026. Set whichever your dashboard shows — the app reads either,
# and prefers the new one.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Only if your project still shows a legacy anon key instead. Leave the
# line above blank if you use this one.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------
# SECRET KEY — DANGEROUS. Bypasses row-level security completely.
# Server-side only. Never in a client component, never in a commit,
# never pasted into a chat window.
#
# Supabase is replacing the old "service_role" key with a "secret" key
# (starts with sb_secret_). Set whichever your dashboard shows.
# ---------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Only if your project still shows a legacy service_role key instead.
# SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------
# CAN'T FIND THE PROJECT URL?
# Look at your browser's address bar while you're inside the project:
#     https://supabase.com/dashboard/project/abcdefghijklmnop
#                                            ^^^^^^^^^^^^^^^^
#                                            this is your project ref
# Your URL is then:  https://abcdefghijklmnop.supabase.co
# That always works, whatever the dashboard looks like this month.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# ADMIN REVIEW QUEUE — optional, and OFF unless you set it.
#
# Leave this UNSET in Vercel. With no password set there is no admin area
# in production at all — not a locked door, no door. Review locally
# against the same database instead; nothing about publishing needs the
# admin screen exposed on the internet.
#
# Set it in .env.local only. Use something long and random:
#   openssl rand -base64 24
# ---------------------------------------------------------------------
# ADMIN_PASSWORD=
